{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/web4hub/Web4hub/blob/main/schemas/ecosystem.schema.json",
  "title": "Web4hub Ecosystem",
  "type": "object",
  "required": ["name", "version", "domains"],
  "properties": {
    "name": {"const": "Web4hub"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "type": "array",
      "items": {"enum": ["identity", "protocols", "infrastructure", "applications", "ecosystem"]}
    }
  },
  "additionalProperties": false
}
